[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%ManufacturerName%
CatalogFile=2synvhid.cat
DriverVer=08/06/2026,1.0.0.0
PnpLockdown=1

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%DeviceName%=Device_Install,Root\2SYNVHID

[SourceDisksNames]
1=%DiskName%,,,""

[SourceDisksFiles]
2synvhid.sys=1

[DestinationDirs]
DefaultDestDir=12

[Device_Install.NT]
CopyFiles=DriverCopy

[Device_Install.NT.HW]
AddReg=Device_AddReg

[Device_AddReg]
HKR,,"LowerFilters",0x00010000,"vhf"

[Device_Install.NT.Services]
AddService=2synvhid,%SPSVCINST_ASSOCSERVICE%,Service_Install

[DriverCopy]
2synvhid.sys

[Service_Install]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\2synvhid.sys

[Device_Install.NT.Wdf]
KmdfService=2synvhid,2synvhid_Wdf

[2synvhid_Wdf]
KmdfLibraryVersion=1.33

[Strings]
ManufacturerName="2syn"
DeviceName="2syn Virtual HID Keyboard"
DiskName="2syn Virtual HID Keyboard Installation Disk"
SPSVCINST_ASSOCSERVICE=0x00000002
